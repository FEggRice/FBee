<Window x:Class="FBee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FBee" Width="256" Height="256"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" Topmost="True" ResizeMode="NoResize"
        MouseLeftButtonDown="OnMouseLeftButtonDown" MouseLeftButtonUp="OnMouseLeftButtonUp" MouseMove="OnMouseMove">
    <Grid Background="Transparent">
        <Ellipse Width="170" Height="34" Fill="#33000000" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        <Image x:Name="PetImage" Stretch="Uniform" Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock x:Name="StateText" Text="idle" FontSize="12" HorizontalAlignment="Center" Foreground="White" />
            <ProgressBar x:Name="EnergyBar" Width="100" Height="6" Minimum="0" Maximum="100" />
        </StackPanel>
    </Grid>
</Window>
